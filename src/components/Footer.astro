---
import SocialIcon from './SocialIcon.astro';
import { AUTHOR, SOCIAL } from '../config';

const year = new Date().getFullYear();

/**
 * The visible destination, so the accessible name and the hover title say
 * where the link goes rather than just naming the service.
 */
const destination = (href: string) =>
  href.startsWith('mailto:') ? href.slice('mailto:'.length) : href.replace(/^https?:\/\//, '');
---
<footer class="site-footer">
  <div class="footer-main">
    <ul class="social">
      {
        SOCIAL.map((item) => {
          const name = `${item.label}: ${destination(item.href)}`;
          const external = !item.href.startsWith('mailto:');
          return (
            <li>
              <a
                href={item.href}
                aria-label={name}
                title={name}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                <SocialIcon name={item.icon} />
              </a>
            </li>
          );
        })
      }
    </ul>

    <p class="copyright">&copy; {year} {AUTHOR}</p>
  </div>

  <p class="footer-note">
    P.S. I much prefer in-person deep talk or a reserved call to online messaging.
    My phone is always on Do Not Disturb, and I do not check it very often.
    Apologies for the late replies.
  </p>
</footer>
