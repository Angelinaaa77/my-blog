---
import HobbyCard from './HobbyCard.astro';

const hobbies = [
  { rank: 'A', suit: '♠', suitName: 'spades', name: 'Poker', glyph: '♠', detail: 'Happy to play poker, bridge, blackjack, and 24.' },
  { rank: 'K', suit: '♠', suitName: 'spades', name: 'Piano', icon: 'piano-keyboard', detail: 'Mozart · Chopin · Richard Clayderman.' },
  { rank: 'Q', suit: '♠', suitName: 'spades', name: 'Chess', glyph: '♛', detail: 'Still learning.' },
  { rank: 'J', suit: '♠', suitName: 'spades', name: 'Bartending', icon: 'cocktail-lemon', detail: 'New York State license. Happy to serve you a drink.' },
  { rank: '10', suit: '♠', suitName: 'spades', name: 'Bouldering', glyph: '⌃', detail: 'More effective for shaping muscle definition than lifting.' },
  { rank: '7', suit: '♦', suitName: 'diamonds', name: 'Equestrian', glyph: '♘', detail: 'Show jumping · dressage. Stopped after coming to the city.' },
  { rank: '7', suit: '♣', suitName: 'clubs', name: 'Reading', glyph: '¶', detail: 'Banned books.' },
];
---

<section class="hobby-seven" aria-labelledby="hobby-seven-title">
  <header class="hobby-heading">
    <p class="section-index"><span>OTIUM / 07</span><span>A PERSONAL CATALOGUE</span></p>
    <h2 id="hobby-seven-title">My unstructured<br /><em>leisure time</em></h2>
    <p class="hobby-deck">
      <em>Otium</em> is the Roman word for time that is not owed to anyone. Not leisure in the
      sense of recovery, but the free attention out of which anything worth doing eventually
      comes. Its opposite, <em>negotium</em>, literally means “not otium”: business, the absence
      of the good thing. I find that framing more useful than our own, which treats work as
      the default and free time as what is left over.
    </p>
    <p class="hobby-flip-hint"><span aria-hidden="true">↻</span> Flip any card to see my hobbies.</p>
  </header>

  <p class="hobby-row-label">IN HAND <span>02</span></p>
  <div class="hobby-row hobby-row-hand" aria-label="Two cards in hand: poker and piano">
    {hobbies.slice(0, 2).map((hobby) => <HobbyCard hobby={hobby} />)}
  </div>

  <p class="hobby-row-label">PUBLIC BOARD <span>05</span></p>
  <div class="hobby-row hobby-row-public" aria-label="Five public cards: chess, bartending, bouldering, equestrian, and reading">
    {hobbies.slice(2).map((hobby) => <HobbyCard hobby={hobby} />)}
  </div>

  <p class="hobby-caption"><span>02</span> IN HAND <i>·</i> <span>05</span> PUBLIC <i>·</i> <strong>07</strong> TOTAL</p>
  <p class="royal-flush-note"><span>BEST FIVE</span> ROYAL FLUSH <i>·</i> A♠ K♠ Q♠ J♠ 10♠</p>
</section>
