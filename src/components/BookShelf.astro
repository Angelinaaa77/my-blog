---
import type { Book } from '../lib/content';

interface Props {
  books: Book[];
  /** Named in the empty state, e.g. "antilibrary". */
  label: string;
}

const { books, label } = Astro.props;

/** Local filenames resolve under /images/books/; absolute URLs are used as-is. */
const coverSrc = (cover: string) =>
  cover.startsWith('http') ? cover : `/images/books/${cover}`;
---
{
  books.length === 0 ? (
    <p class="shelf-empty">Nothing on the {label} shelf yet.</p>
  ) : (
    <ul class="shelf">
      {books.map((book) => (
        <li>
          {/*
            The cover is the link. Title and author live inside it as real text
            rather than a tooltip, so the link has an accessible name, screen
            readers get it, and touch devices — which have no hover — can show
            it permanently via the (hover: none) rule.
          */}
          <a class="book" href={book.data.url} target="_blank" rel="noopener noreferrer">
            <span class="book-cover">
              <img src={coverSrc(book.data.cover)} alt="" loading="lazy" />
            </span>
            <span class="book-meta">
              <span class="book-title">{book.data.title}</span>
              <span class="book-author">{book.data.author}</span>
              {book.data.note && <span class="book-note">{book.data.note}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}
