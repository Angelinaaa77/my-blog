---
import { withBase } from '../lib/site-path';

interface Props {
  src: string;
  alt?: string;
}

const { src, alt = '' } = Astro.props;
const imageSrc = withBase(src);
---
<figure class="banner banner-signature">
  <span
    class="banner-signature-art"
    role="img"
    aria-label={alt}
    style={`--banner-signature: url("${imageSrc}")`}
  />
  <figcaption class="hero-caption">Angelina Huang <span>/</span> Signature</figcaption>
</figure>
