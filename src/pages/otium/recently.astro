---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecentlyList from '../../components/RecentlyList.astro';
import { getRecent } from '../../lib/content';
import { withBase } from '../../lib/site-path';

const entries = await getRecent();
---
<BaseLayout
  title="Recently"
  description="A running log: books, music, and things I noticed."
>
  <article>
    <header class="page-header">
      <h1>Recently</h1>
      <p class="page-meta">{entries.length} entries</p>
    </header>

    <p class="page-lede">
      Short notes, newest first. The most recent ten also appear on{' '}
      <a href={withBase('/otium/')}>Otium</a>.
    </p>

    <RecentlyList entries={entries} />
  </article>
</BaseLayout>
