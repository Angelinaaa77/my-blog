---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import DraftNotice from '../../components/DraftNotice.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { sectionPaths, type Page } from '../../lib/content';

export const getStaticPaths = (async () => sectionPaths('philosophy')) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page };
const { Content, headings } = await render(page);
const { title, updated, draft, description } = page.data;
---
<BaseLayout title={title} description={description}>
  {draft && <DraftNotice />}

  <article>
    <PageHeader title={title} updated={updated} draft={draft} />
    <TableOfContents headings={headings} />
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
