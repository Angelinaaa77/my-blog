---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DraftNotice from '../../../components/DraftNotice.astro';
import BookShelf from '../../../components/BookShelf.astro';
import Crosslinks from '../../../components/Crosslinks.astro';
import { sectionPaths, getShelf, type Page } from '../../../lib/content';

export const getStaticPaths = (async () =>
  sectionPaths('philosophy/library')) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page };
const { Content } = await render(page);
const { title, updated, draft, description } = page.data;

const books = await getShelf('library');

/** Category order follows first appearance in books.json, so the file sets the page order. */
const categories: string[] = [];
for (const book of books) {
  const category = book.data.category ?? 'Uncategorized';
  if (!categories.includes(category)) categories.push(category);
}
---
<BaseLayout title={title} description={description}>
  {draft && <DraftNotice />}

  <article>
    <PageHeader title={title} updated={updated} draft={draft} />

    <Crosslinks ids={['philosophy', 'philosophy/antilibrary']} />

    <div class="prose">
      <Content />
    </div>
  </article>

  {categories.map((category) => {
    const shelf = books.filter(
      (book) => (book.data.category ?? 'Uncategorized') === category,
    );
    return (
      <section class="shelf-section">
        <h2 class="shelf-heading">{category}</h2>
        <BookShelf books={shelf} label={category.toLowerCase()} />
      </section>
    );
  })}
</BaseLayout>
